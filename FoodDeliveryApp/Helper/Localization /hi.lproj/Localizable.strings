"aboutus_screen_inside_title" = "हमारे बारे में";
"aboutus_screen_inside_first_text" = "हमारा मिशन एक सहज और सरल खरीदारी अनुभव प्रदान करना है जो उपयोगकर्ता संतोष को प्राथमिकता देता है। हम ऐसा प्लेटफ़ॉर्म बनाने का लक्ष्य रखते हैं जहाँ ब्राउज़िंग, खरीदारी और उत्पाद प्रबंधन सहज और आसान लगे, हमारी सरल उपयोगकर्ता इंटरफ़ेस और विश्वसनीय सेवा के कारण।";
"aboutus_screen_inside_second_text" = "हम प्रदर्शन, पारदर्शिता और विश्वास के उच्च मानकों को बनाए रखने के लिए समर्पित हैं। हमारी टीम लगातार ऐप की कार्यक्षमता बढ़ाने, डेटा गोपनीयता सुनिश्चित करने और प्रतिक्रियाशील ग्राहक सहायता प्रदान करने के लिए काम करती रहती है, जिससे आपकी खरीदारी की यात्रा सुचारू और सुरक्षित बनी रहे।";
"aboutus_screen_inside_third_text" = "आपकी प्रतिक्रिया महत्वपूर्ण है। यदि आपके कोई प्रश्न, सुझाव हैं या किसी समस्या का सामना करते हैं, तो हम मदद के लिए यहाँ हैं। हमारी सपोर्ट पेज के माध्यम से या सीधे हमें ईमेल करके संपर्क करें। साथ मिलकर, हम सभी के लिए एक बेहतर और अधिक समावेशी अनुभव बनाने का प्रयास करते हैं।";
"aboutus_screen_inside_fourth_text" = "हम मानते हैं कि तकनीक को लोगों की सेवा करनी चाहिए। इसलिए हम वास्तविक उपयोगकर्ता व्यवहार और जरूरतों के आधार पर अपने प्लेटफ़ॉर्म को लगातार सुधारते रहते हैं, ताकि हर इंटरैक्शन तेज़, सरल और अधिक सुखदायक बने।";
"aboutus_screen_inside_fifth_text" = "सुरक्षा हमारी प्राथमिकता है। हम आपके व्यक्तिगत डेटा की सुरक्षा के लिए उद्योग-मानक प्रोटोकॉल का उपयोग करते हैं और हमेशा एक सुरक्षित और सुरक्षित खरीदारी वातावरण प्रदान करते हैं।";
"aboutus_screen_inside_sixth_text" = "हम पहुँच और समावेशिता को महत्व देते हैं। हमारा प्लेटफ़ॉर्म सभी पृष्ठभूमियों, उपकरणों और तकनीकी क्षमताओं वाले लोगों द्वारा उपयोग करने योग्य बनाया गया है, जिससे सभी हमारी सेवाओं का लाभ उठा सकें।";
"aboutus_screen_inside_seventh_text" = "सततता हमारे लिए महत्वपूर्ण है। हम पर्यावरण-मैत्रीपूर्ण व्यावसायिक प्रथाओं का समर्थन करते हैं और अपने मूल्यों को साझा करने वाले भागीदारों के साथ मिलकर काम करते हैं ताकि हमारे पर्यावरणीय प्रभाव को कम किया जा सके।";

